<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScrollShot</AssemblyName>
    <RootNamespace>ScrollShot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>ScrollShot</Product>
    <Company>ScrollShot</Company>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScrollShot.Tests" />
    <Compile Remove="ScrollShot.Tests\**" />
    <EmbeddedResource Remove="ScrollShot.Tests\**" />
    <None Remove="ScrollShot.Tests\**" />
    <Page Remove="ScrollShot.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>
</Project>
