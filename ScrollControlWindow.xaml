<Window x:Class="ScrollShot.ScrollControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="13">
    <Border Background="#F2202124" CornerRadius="10" Padding="12" BorderBrush="#555" BorderThickness="1"
            Margin="6" MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <TextBlock x:Name="Status" Foreground="White" Margin="0,0,0,8" MinWidth="380"
                       MaxWidth="480" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Bar" Height="4" Margin="0,0,0,8" Minimum="0" Maximum="100" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAuto" Content="شروع خودکار" Click="OnAuto" Padding="12,5" Margin="0,0,6,0"/>
                <Button x:Name="BtnManual" Content="حالت دستی" Click="OnManual" Padding="12,5" Margin="0,0,6,0"/>
                <Button x:Name="BtnDone" Content="پایان و ذخیره" Click="OnDone" Padding="12,5" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="BtnCancel" Content="لغو" Click="OnCancel" Padding="12,5"/>
            </StackPanel>
            <CheckBox x:Name="ChkTop" Content="قبل از شروع، صفحه را به بالا برگردان" Foreground="#DDDDDD"
                      Margin="0,8,0,0" Checked="OnTopChanged" Unchecked="OnTopChanged"/>
            <TextBlock x:Name="Hint" Foreground="#999999" FontSize="11" Margin="0,6,0,0"
                       Text="Esc = لغو   |   فشردن دوباره میانبر اسکرولی = پایان"/>
        </StackPanel>
    </Border>
</Window>
