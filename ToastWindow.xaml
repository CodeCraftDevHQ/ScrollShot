<Window x:Class="ScrollShot.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" SizeToContent="WidthAndHeight" AllowsTransparency="True"
        Background="Transparent" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="12">
    <Border Background="#F2202124" CornerRadius="12" BorderBrush="#555" BorderThickness="1" Margin="10" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Width="240">
            <Image x:Name="Thumb" Width="240" Height="150" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="OnOpenMouse"/>
            <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock x:Name="Sub" Foreground="#BBBBBB" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnOpen" Content="باز کردن" Click="OnOpen" Padding="8,3" Margin="0,0,4,0"/>
                <Button x:Name="BtnFolder" Content="پوشه" Click="OnFolder" Padding="8,3" Margin="0,0,4,0"/>
                <Button x:Name="BtnDelete" Content="حذف" Click="OnDelete" Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="بستن" Click="OnClose" Padding="8,3"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
