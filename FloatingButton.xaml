<Window x:Class="ScrollShot.FloatingButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        Width="48" Height="48">
    <Grid>
        <Ellipse Fill="#E63B82F6" Stroke="White" StrokeThickness="2"/>
        <TextBlock x:Name="Glyph" Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</Window>
