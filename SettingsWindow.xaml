<Window x:Class="ScrollShot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScrollShot"
        Title="تنظیمات ScrollShot" Width="580" Height="640" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="ذخیره" Click="OnSave" IsDefault="True" Padding="20,5" Margin="0,0,8,0"/>
            <Button Content="انصراف" Click="OnCancel" IsCancel="True" Padding="20,5" Margin="0,0,8,0"/>
            <Button Content="بازنشانی به پیش‌فرض" Click="OnReset" Padding="12,5"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="عمومی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <DockPanel Margin="0,5">
                            <TextBlock Text="پوشه ذخیره" Width="190" VerticalAlignment="Center"/>
                            <Button Content="انتخاب…" DockPanel.Dock="Right" Click="OnBrowse" Padding="10,2" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtFolder" Text="{Binding SaveFolder}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="الگوی نام فایل" Width="190" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding FileNamePattern}" ToolTip="{}{date} {time} {type}" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="فرمت تصویر" Width="190" VerticalAlignment="Center"/>
                            <ComboBox Width="140" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Format}">
                                <ComboBoxItem Tag="png" Content="PNG"/>
                                <ComboBoxItem Tag="jpg" Content="JPG"/>
                                <ComboBoxItem Tag="bmp" Content="BMP"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="کیفیت JPG" Width="190" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldQ, StringFormat=N0}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldQ" Minimum="40" Maximum="100" Value="{Binding JpgQuality}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        </DockPanel>
                        <CheckBox Content="ذخیره در فایل" IsChecked="{Binding SaveToFile}" Margin="0,5"/>
                        <CheckBox Content="کپی در کلیپ‌بورد" IsChecked="{Binding CopyToClipboard}" Margin="0,5"/>
                        <CheckBox Content="نمایش پیش‌نمایش پس از گرفتن" IsChecked="{Binding ShowToast}" Margin="0,5"/>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="مدت نمایش پیش‌نمایش (ثانیه)" Width="190" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ToastSeconds}" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <CheckBox Content="پخش صدا" IsChecked="{Binding PlaySound}" Margin="0,5"/>
                        <CheckBox Content="اجرا همراه ویندوز" IsChecked="{Binding StartWithWindows}" Margin="0,5"/>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="تمام صفحه از" Width="190" VerticalAlignment="Center"/>
                            <ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding FullScreenScope}">
                                <ComboBoxItem Tag="cursor" Content="مانیتوری که ماوس روی آن است"/>
                                <ComboBoxItem Tag="all" Content="همه مانیتورها"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="تأخیر گرفتن (ثانیه)" Width="190" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DelaySeconds}" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="میانبرها و دکمه شناور">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="روی کادر کلیک کنید و ترکیب کلید را بزنید. Backspace برای پاک کردن." Margin="0,0,0,8" Foreground="Gray"/>
                        <DockPanel Margin="0,5"><TextBlock Text="گرفتن از ناحیه" Width="190" VerticalAlignment="Center"/><local:HotkeyBox x:Name="HkRegion"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="گرفتن از پنجره" Width="190" VerticalAlignment="Center"/><local:HotkeyBox x:Name="HkWindow"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="تمام صفحه" Width="190" VerticalAlignment="Center"/><local:HotkeyBox x:Name="HkFull"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="اسکرین‌شات اسکرولی" Width="190" VerticalAlignment="Center"/><local:HotkeyBox x:Name="HkScroll"/></DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="دابل‌کلیک روی آیکون tray" Width="190" VerticalAlignment="Center"/>
                            <ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding TrayDoubleClick}">
                                <ComboBoxItem Tag="region" Content="گرفتن از ناحیه"/>
                                <ComboBoxItem Tag="window" Content="گرفتن از پنجره"/>
                                <ComboBoxItem Tag="full" Content="تمام صفحه"/>
                                <ComboBoxItem Tag="scroll" Content="اسکرولی"/>
                                <ComboBoxItem Tag="settings" Content="تنظیمات"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox Content="نمایش دکمه شناور" IsChecked="{Binding ShowFloatingButton}" Margin="0,12,0,5"/>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="اندازه دکمه شناور" Width="190" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldSize, StringFormat=N0}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldSize" Minimum="32" Maximum="96" Value="{Binding FloatingSize}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="شفافیت دکمه شناور" Width="190" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldOp, StringFormat=N2}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldOp" Minimum="0.2" Maximum="1" Value="{Binding FloatingOpacity}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="ظاهر انتخاب">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <DockPanel Margin="0,5">
                            <TextBlock Text="تیرگی پس‌زمینه" Width="190" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldDim, StringFormat=N2}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldDim" Minimum="0.05" Maximum="0.9" Value="{Binding OverlayDim}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="رنگ کادر انتخاب (hex)" Width="190" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SelectionColor}" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="ضخامت کادر" Width="190" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldTh, StringFormat=N0}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldTh" Minimum="1" Maximum="8" Value="{Binding SelectionThickness}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="رنگ کادر اسکرول (hex)" Width="190" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding FrameColor}" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <CheckBox Content="نمایش اندازه ناحیه" IsChecked="{Binding ShowSizeLabel}" Margin="0,5"/>
                        <CheckBox Content="نمایش خطوط راهنما (crosshair)" IsChecked="{Binding ShowCrosshair}" Margin="0,5"/>
                        <CheckBox Content="هایلایت پنجره زیر ماوس (با Ctrl: بخش داخلی پنجره)" IsChecked="{Binding HighlightWindows}" Margin="0,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="اسکرول">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <DockPanel Margin="0,5">
                            <TextBlock Text="حالت پیش‌فرض" Width="190" VerticalAlignment="Center"/>
                            <ComboBox Width="160" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ScrollMode}">
                                <ComboBoxItem Tag="auto" Content="خودکار"/>
                                <ComboBoxItem Tag="manual" Content="دستی"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="شمارش معکوس قبل از شروع (ثانیه، 0 = دستی)" Width="190" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBox Text="{Binding ScrollCountdownSec}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <CheckBox Content="قبل از شروع، صفحه را به بالا برگردان" IsChecked="{Binding ScrollFromTop}" Margin="0,5"/>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="نوچ اسکرول در هر گام (شروع، خودکار تنظیم می‌شود)" Width="190" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Value, ElementName=SldNotch, StringFormat=N0}" Width="36" DockPanel.Dock="Right"/>
                            <Slider x:Name="SldNotch" Minimum="1" Maximum="20" Value="{Binding ScrollNotches}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        </DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="تأخیر بعد از هر اسکرول (ms)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding ScrollDelayMs}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="حداکثر صبر برای ثابت شدن (ms)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding ScrollStableTimeoutMs}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="حداکثر ارتفاع تصویر (px)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding MaxHeightPx}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="حداکثر تعداد فریم" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding MaxFrames}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="نادیده گرفتن لبه راست (px)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding IgnoreRightPx}" Width="100" HorizontalAlignment="Left" ToolTip="برای اسکرول‌بار"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="نادیده گرفتن لبه چپ (px)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding IgnoreLeftPx}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                        <DockPanel Margin="0,5"><TextBlock Text="تلورانس تطبیق (۱ تا ۳۰)" Width="190" VerticalAlignment="Center"/><TextBox Text="{Binding MatchTolerance}" Width="100" HorizontalAlignment="Left"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
