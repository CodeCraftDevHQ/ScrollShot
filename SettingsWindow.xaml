<Window x:Class="ScrollShot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:ScrollShot"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{local:Loc settings_title}" Width="900" Height="680" MinWidth="760" MinHeight="520"
        FlowDirection="{Binding Flow, Source={x:Static local:LocalizationSource.Instance}}"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,16,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="250"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Nav" Grid.Row="0" Grid.Column="0" SelectionChanged="OnNav" Background="Transparent" BorderThickness="0">
            <ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_general}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_output}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_hotkeys}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_scrolling}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_appearance}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_profiles}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_share}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_record}" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Margin="4,6"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="{local:Loc nav_about}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
        </ListBox>
        <Grid Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
            <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_saving}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_folder}"/><Button Content="{local:Loc btn_browse}" DockPanel.Dock="Right" Click="OnBrowse" Margin="8,0,0,0"/><TextBox x:Name="TxtFolder" Text="{Binding SaveFolder}"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_pattern}"/><TextBox Text="{Binding FileNamePattern}" FlowDirection="LeftToRight" ToolTip="{local:Loc gen_pattern_tip}"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_format}"/><ComboBox Width="160" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Format}"><ComboBoxItem Tag="png" Content="PNG"/><ComboBoxItem Tag="jpg" Content="JPG"/><ComboBoxItem Tag="bmp" Content="BMP"/><ComboBoxItem Tag="pdf" Content="PDF"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_quality}"/><TextBlock Text="{Binding Value, ElementName=SldQ, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldQ" Minimum="40" Maximum="100" Value="{Binding JpgQuality}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><CheckBox Content="{local:Loc gen_save_file}" IsChecked="{Binding SaveToFile}" Margin="0,6"/><CheckBox Content="{local:Loc gen_clipboard}" IsChecked="{Binding CopyToClipboard}" Margin="0,6"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_after}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{local:Loc gen_toast}" IsChecked="{Binding ShowToast}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_toast_sec}"/><TextBox Text="{Binding ToastSeconds}" Width="80" HorizontalAlignment="Left"/></DockPanel><CheckBox Content="{local:Loc gen_sound}" IsChecked="{Binding PlaySound}" Margin="0,6"/><CheckBox Content="{local:Loc gen_startup}" IsChecked="{Binding StartWithWindows}" Margin="0,6"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_capture}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_full_scope}"/><ComboBox Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding FullScreenScope}"><ComboBoxItem Tag="cursor" Content="{local:Loc scope_cursor}"/><ComboBoxItem Tag="all" Content="{local:Loc scope_all}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc gen_delay}"/><TextBox Text="{Binding DelaySeconds}" Width="80" HorizontalAlignment="Left"/></DockPanel></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_size}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_scale}"/><TextBlock Text="{Binding Value, ElementName=SldScale, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldScale" Minimum="10" Maximum="100" Value="{Binding ScalePercent}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_maxw}"/><TextBox Text="{Binding MaxWidthPx}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_target}" ToolTip="{local:Loc out_target_tip}"/><TextBox Text="{Binding TargetSizeKB}" Width="110" HorizontalAlignment="Left"/></DockPanel></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_split}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{local:Loc out_split}" IsChecked="{Binding SplitEnabled}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_split_h}"/><TextBox Text="{Binding SplitHeightPx}" Width="110" HorizontalAlignment="Left"/></DockPanel><CheckBox Content="{local:Loc out_smart}" IsChecked="{Binding SmartCut}" Margin="0,6"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_pdf}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{local:Loc out_alsopdf}" IsChecked="{Binding AlsoSavePdf}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_pdf_layout}"/><ComboBox Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding PdfPageMode}"><ComboBoxItem Tag="a4" Content="{local:Loc pdf_multi}"/><ComboBoxItem Tag="single" Content="{local:Loc pdf_single}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_pdf_size}"/><ComboBox Width="160" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding PdfPageSize}"><ComboBoxItem Tag="a4" Content="A4"/><ComboBoxItem Tag="letter" Content="Letter"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_pdf_margin}"/><TextBox Text="{Binding PdfMarginMm}" Width="80" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc out_pdf_q}"/><TextBlock Text="{Binding Value, ElementName=SldPdfQ, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldPdfQ" Minimum="30" Maximum="100" Value="{Binding PdfJpegQuality}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><TextBlock Text="{local:Loc out_pdf_note}" Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Text="{local:Loc hk_hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_hotkeys}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_region}"/><local:HotkeyBox x:Name="HkRegion"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_window}"/><local:HotkeyBox x:Name="HkWindow"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_full}"/><local:HotkeyBox x:Name="HkFull"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_scroll}"/><local:HotkeyBox x:Name="HkScroll"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_region_delay}"/><local:HotkeyBox x:Name="HkRegionDelay"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_record}"/><local:HotkeyBox x:Name="HkRecord"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_profile}"/><local:HotkeyBox x:Name="HkProfile"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc hk_tray_dbl}"/><ComboBox Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding TrayDoubleClick}"><ComboBoxItem Tag="region" Content="{local:Loc act_region}"/><ComboBoxItem Tag="window" Content="{local:Loc act_window}"/><ComboBoxItem Tag="full" Content="{local:Loc act_full}"/><ComboBoxItem Tag="scroll" Content="{local:Loc act_scroll}"/><ComboBoxItem Tag="record" Content="{local:Loc act_record}"/><ComboBoxItem Tag="settings" Content="{local:Loc act_settings}"/></ComboBox></DockPanel></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_floating}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{local:Loc fl_show}" IsChecked="{Binding ShowFloatingButton}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc fl_size}"/><TextBlock Text="{Binding Value, ElementName=SldSize, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldSize" Minimum="32" Maximum="96" Value="{Binding FloatingSize}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc fl_opacity}"/><TextBlock Text="{Binding Value, ElementName=SldOp, StringFormat=N2}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldOp" Minimum="0.2" Maximum="1" Value="{Binding FloatingOpacity}"/></DockPanel></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_sc_start}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_direction}"/><ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ScrollDirection}"><ComboBoxItem Tag="vertical" Content="{local:Loc dir_vertical}"/><ComboBoxItem Tag="horizontal" Content="{local:Loc dir_horizontal}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_mode}"/><ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ScrollMode}"><ComboBoxItem Tag="auto" Content="{local:Loc mode_auto}"/><ComboBoxItem Tag="manual" Content="{local:Loc mode_manual}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_countdown}"/><TextBox Text="{Binding ScrollCountdownSec}" Width="80" HorizontalAlignment="Left"/></DockPanel><CheckBox Content="{local:Loc sc_top}" IsChecked="{Binding ScrollFromTop}" Margin="0,6"/><CheckBox Content="{local:Loc sc_mouse}" IsChecked="{Binding ScrollWithoutMouse}" Margin="0,6"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_sc_trim}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="{local:Loc sc_trim_header}" IsChecked="{Binding TrimHeader}" Margin="0,6"/><CheckBox Content="{local:Loc sc_trim_footer}" IsChecked="{Binding TrimFooter}" Margin="0,6"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_sc_tuning}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_notches}"/><TextBlock Text="{Binding Value, ElementName=SldNotch, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldNotch" Minimum="1" Maximum="20" Value="{Binding ScrollNotches}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_delay}"/><TextBox Text="{Binding ScrollDelayMs}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_stable}"/><TextBox Text="{Binding ScrollStableTimeoutMs}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_maxh}"/><TextBox Text="{Binding MaxHeightPx}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_maxframes}"/><TextBox Text="{Binding MaxFrames}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_ignr}"/><TextBox Text="{Binding IgnoreRightPx}" Width="110" HorizontalAlignment="Left" ToolTip="{local:Loc sc_ignr_tip}"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_ignl}"/><TextBox Text="{Binding IgnoreLeftPx}" Width="110" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sc_tol}"/><TextBox Text="{Binding MatchTolerance}" Width="80" HorizontalAlignment="Left"/></DockPanel><CheckBox Content="{local:Loc sc_debug}" IsChecked="{Binding DebugDumpFrames}" Margin="0,6"/></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_language}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_language}"/><ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Language}" x:Name="LangBox" SelectionChanged="OnLangChanged"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="fa" Content="فارسی"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_theme}"/><ComboBox Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Theme}" x:Name="ThemeBox" SelectionChanged="OnThemeChanged"><ComboBoxItem Tag="dark" Content="{local:Loc theme_dark}"/><ComboBoxItem Tag="light" Content="{local:Loc theme_light}"/><ComboBoxItem Tag="system" Content="{local:Loc theme_system}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_accent}"/><TextBox x:Name="AccentBox" Text="{Binding AccentColor}" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight" LostFocus="OnAccentChanged"/></DockPanel><WrapPanel x:Name="Swatches" Margin="0,4,0,0"/></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_selection}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_dim}"/><TextBlock Text="{Binding Value, ElementName=SldDim, StringFormat=N2}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldDim" Minimum="0.05" Maximum="0.9" Value="{Binding OverlayDim}"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_selcolor}"/><TextBox Text="{Binding SelectionColor}" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_thick}"/><TextBlock Text="{Binding Value, ElementName=SldTh, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldTh" Minimum="1" Maximum="8" Value="{Binding SelectionThickness}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_framecolor}"/><TextBox Text="{Binding FrameColor}" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></DockPanel><CheckBox Content="{local:Loc ap_size}" IsChecked="{Binding ShowSizeLabel}" Margin="0,6"/><CheckBox Content="{local:Loc ap_cross}" IsChecked="{Binding ShowCrosshair}" Margin="0,6"/><CheckBox Content="{local:Loc ap_hl}" IsChecked="{Binding HighlightWindows}" Margin="0,6"/><CheckBox Content="{local:Loc ap_mag}" IsChecked="{Binding ShowMagnifier}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc ap_mag_zoom}"/><TextBlock Text="{Binding Value, ElementName=SldMag, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldMag" Minimum="4" Maximum="20" Value="{Binding MagnifierZoom}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page5" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_profiles}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{local:Loc pf_hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="ActiveText" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="ProfileList" DisplayMemberPath="Name" MinHeight="150" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="{local:Loc pf_apply}" Click="OnProfileApply" Margin="0,0,8,0" MinWidth="90"/><Button Content="{local:Loc pf_delete}" Click="OnProfileDelete" MinWidth="90"/></StackPanel><DockPanel Margin="0,4"><Button Content="{local:Loc pf_save}" DockPanel.Dock="Right" Click="OnProfileSave" Margin="8,0,0,0"/><TextBox x:Name="ProfileName"/></DockPanel></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page6" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Text="{local:Loc sh_hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_share}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sh_editor}"/><TextBox Text="{Binding EditorPath}" FlowDirection="LeftToRight"/></DockPanel></StackPanel></Border><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_upload}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sh_upload_url}"/><TextBox Text="{Binding UploadUrl}" FlowDirection="LeftToRight"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sh_field}"/><TextBox Text="{Binding UploadFileField}" Width="160" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sh_header}"/><TextBox Text="{Binding UploadHeader}" FlowDirection="LeftToRight"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc sh_regex}"/><TextBox Text="{Binding UploadResponseRegex}" FlowDirection="LeftToRight"/></DockPanel><CheckBox Content="{local:Loc sh_auto}" IsChecked="{Binding UploadAuto}" Margin="0,6"/></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page7" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Text="{local:Loc rec_hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_record}"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_format}"/><ComboBox Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding RecordFormat}"><ComboBoxItem Tag="gif" Content="{local:Loc fmt_gif}"/><ComboBoxItem Tag="mp4" Content="{local:Loc fmt_mp4}"/></ComboBox></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_fps}"/><TextBlock Text="{Binding Value, ElementName=SldFps, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldFps" Minimum="5" Maximum="30" Value="{Binding RecordFps}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_max}"/><TextBox Text="{Binding RecordMaxSeconds}" Width="80" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_scale}"/><TextBlock Text="{Binding Value, ElementName=SldRecScale, StringFormat=N0}" Width="44" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="SldRecScale" Minimum="25" Maximum="100" Value="{Binding RecordScalePercent}" IsSnapToTickEnabled="True" TickFrequency="1"/></DockPanel><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_countdown_s}"/><TextBox Text="{Binding RecordCountdownSec}" Width="80" HorizontalAlignment="Left"/></DockPanel><CheckBox Content="{local:Loc rec_cursor}" IsChecked="{Binding RecordCursor}" Margin="0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc rec_ffmpeg}"/><TextBox Text="{Binding FfmpegPath}" FlowDirection="LeftToRight"/></DockPanel></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Page8" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,8,16"><TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc sec_about}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{local:Loc upd_hint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"/><DockPanel Margin="0,6"><TextBlock Style="{StaticResource RowLabel}" Text="{local:Loc upd_url}"/><TextBox Text="{Binding UpdateCheckUrl}" FlowDirection="LeftToRight"/></DockPanel><CheckBox Content="{local:Loc upd_auto}" IsChecked="{Binding UpdateAuto}" Margin="0,6"/><Button Content="{local:Loc upd_check}" Click="OnCheckUpdate" Margin="0,8,0,4" MinWidth="140"/></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{local:Loc btn_reset}" Click="OnReset" Margin="0,0,8,0" MinWidth="120"/>
            <Button Content="{local:Loc btn_cancel}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" MinWidth="100"/>
            <Button x:Name="BtnSave" Content="{local:Loc btn_save}" Click="OnSave" IsDefault="True" MinWidth="100" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
